# Copy to .env and fill in. Never commit .env.

# OpenRouter (separate key from the n8n system)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Check exact slugs at https://openrouter.ai/models
CONSULTANT_MODEL=anthropic/claude-sonnet-5.5
CLASSIFIER_MODEL=anthropic/claude-haiku-5.5

# Local Postgres from docker-compose.yml (port 5433 to stay clear of other Postgres instances)
POSTGRES_USER=orion
POSTGRES_PASSWORD=orion_dev
POSTGRES_DB=orion
DATABASE_URL=postgresql://orion:orion_dev@localhost:5433/orion
