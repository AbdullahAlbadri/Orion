# Copy to .env and fill in. Never commit .env.

# OpenRouter (separate key from the n8n system)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Check exact slugs at https://openrouter.ai/models
# Customer chat (Arabic / English)
CONSULTANT_MODEL=anthropic/claude-opus-5.5
# Chinese manufacturer side; chosen with: uv run python -m evals.manufacturer_models
MANUFACTURER_MODEL=moonshotai/kimi-k3
CLASSIFIER_MODEL=anthropic/claude-haiku-5.5

# Local Postgres from docker-compose.yml (port 5433 to stay clear of other Postgres instances)
POSTGRES_USER=orion
POSTGRES_PASSWORD=orion_dev
POSTGRES_DB=orion
DATABASE_URL=postgresql://orion:orion_dev@localhost:5433/orion

# API and login
# Generate each with: uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
LOGIN_CODE_SECRET=
APP_BASE_URL=http://localhost:3000
# Comma-separated website origins allowed to call the API
CORS_ORIGINS=http://localhost:3000
# Off until set: OAuth client ids from Google Cloud Console / Apple Developer
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
# Set to false only for local development over http
COOKIE_SECURE=true
